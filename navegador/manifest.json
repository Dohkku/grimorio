{
  "manifest_version": 3,
  "name": "Grimorio",
  "description": "Guarda imágenes en tu biblioteca de Grimorio: con el clic derecho en cualquier web y con un botón en Instagram, TikTok y 4chan.",
  "version": "0.1.0",
  "key": "",
  "icons": {
    "16": "iconos/16.png",
    "32": "iconos/32.png",
    "48": "iconos/48.png",
    "128": "iconos/128.png"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "fondo.js"
  },
  "action": {
    "default_title": "Grimorio",
    "default_popup": "ventana.html",
    "default_icon": {
      "16": "iconos/16.png",
      "32": "iconos/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "aviso.js",
        "elegir.js",
        "instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "aviso.js",
        "elegir.js",
        "boton.js",
        "tiktok-datos.js",
        "tiktok.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.4chan.org/*",
        "https://boards.4channel.org/*"
      ],
      "js": [
        "aviso.js",
        "boton.js",
        "4chan-datos.js",
        "4chan.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
